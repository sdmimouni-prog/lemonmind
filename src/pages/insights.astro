---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedInsight from '../components/insights/FeaturedInsight.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import InsightsExperts from '../components/insights/InsightsExperts.astro';
import InsightsFilters from '../components/insights/InsightsFilters.astro';
import InsightsGrid from '../components/insights/InsightsGrid.astro';
import InsightsHero from '../components/insights/InsightsHero.astro';
import InsightsInteractions from '../components/insights/InsightsInteractions.astro';
import InsightsNewsletter from '../components/insights/InsightsNewsletter.astro';
import PremiumResources from '../components/insights/PremiumResources.astro';
import { contact } from '../data/homepage';
import { insightArticles, insightsMeta, publishedInsights } from '../data/insights';
import '../styles/insights.css';

const siteUrl = import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://lemonmind.agency';
const pageUrl = new URL(insightsMeta.canonical, siteUrl).toString();
const organizationId = `${siteUrl}#organization`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Lemon Mind Digital',
      url: siteUrl,
      telephone: contact.phone,
      email: contact.email,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Casablanca',
        addressCountry: 'MA',
      },
      areaServed: {
        '@type': 'Country',
        name: 'Maroc',
      },
    },
    {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}#page`,
      name: insightsMeta.title,
      description: insightsMeta.description,
      url: pageUrl,
      inLanguage: 'fr-MA',
      isPartOf: {
        '@id': siteUrl,
      },
      about: {
        '@id': organizationId,
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Accueil',
          item: new URL('/', siteUrl).toString(),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Insights',
          item: pageUrl,
        },
      ],
    },
    {
      '@type': 'ItemList',
      '@id': `${pageUrl}#editorial-plan`,
      name: 'Sujets éditoriaux Insights Lemon Mind',
      numberOfItems: insightArticles.length,
      itemListElement: insightArticles.map((article) => ({
        '@type': 'ListItem',
        position: article.displayOrder,
        name: article.title,
        description: article.excerpt,
      })),
    },
    {
      '@type': 'ItemList',
      '@id': `${pageUrl}#published-articles`,
      name: 'Articles publiés Lemon Mind',
      numberOfItems: publishedInsights.length,
      itemListElement: publishedInsights.map((article, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: new URL(article.slug, siteUrl).toString(),
        name: article.title,
      })),
    },
  ],
};
---
<BaseLayout
  title={insightsMeta.title}
  description={insightsMeta.description}
  canonical={insightsMeta.canonical}
  ogImage={insightsMeta.ogImage}
  schema={schema}
  bodyClass="insights-page"
>
  <Header ctaLabel="Réservez un appel" ctaHref={contact.bookingHref} />
  <main>
    <InsightsHero />
    <InsightsFilters />
    <FeaturedInsight />
    <InsightsGrid />
    <PremiumResources />
    <InsightsExperts />
    <InsightsNewsletter />
  </main>
  <InsightsInteractions />
  <Footer />
</BaseLayout>
