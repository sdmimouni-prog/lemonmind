---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import InsightArticleBody from '../../components/insights/detail/InsightArticleBody.astro';
import InsightAuthorBox from '../../components/insights/detail/InsightAuthorBox.astro';
import InsightDetailHero from '../../components/insights/detail/InsightDetailHero.astro';
import InsightDetailInteractions from '../../components/insights/detail/InsightDetailInteractions.astro';
import InsightSidebar from '../../components/insights/detail/InsightSidebar.astro';
import InsightTakeaways from '../../components/insights/detail/InsightTakeaways.astro';
import InsightToc from '../../components/insights/detail/InsightToc.astro';
import InsightsInteractions from '../../components/insights/InsightsInteractions.astro';
import InsightsNewsletter from '../../components/insights/InsightsNewsletter.astro';
import { contact } from '../../data/homepage';
import {
  getInsightDetailBySlug,
  getPublishedRelatedInsights,
  insightAuthorsById,
  insightCategories,
  type InsightDetailArticle,
} from '../../data/insights';
import '../../styles/insights.css';
import '../../styles/insight-detail.css';

const article = getInsightDetailBySlug(Astro.params.slug || '');

if (!article) {
  return Astro.redirect('/insights', 302);
}

const typedArticle = article as InsightDetailArticle;
const author = typedArticle.authorId ? insightAuthorsById.get(typedArticle.authorId) : null;

if (!author) {
  return Astro.redirect('/insights', 302);
}

const relatedArticles = getPublishedRelatedInsights(typedArticle);
const category = insightCategories.find((item) => item.id === typedArticle.category);
const siteUrl = import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://lemonmind.agency';
const pageUrl = new URL(typedArticle.canonical, siteUrl).toString();
const organizationId = `${siteUrl}#organization`;
const authorUrl = new URL(author.authorUrl, siteUrl).toString();
const isIndexable = typedArticle.status === 'published';
const keywords = [typedArticle.primaryKeyword, ...typedArticle.secondaryKeywords];

const schemaGraph: object[] = [
  {
    '@type': 'Organization',
    '@id': organizationId,
    name: 'Lemon Mind Digital',
    url: siteUrl,
    telephone: contact.phone,
    email: contact.email,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Casablanca',
      addressCountry: 'MA',
    },
    areaServed: {
      '@type': 'Country',
      name: 'Maroc',
    },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${pageUrl}#breadcrumb`,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Accueil',
        item: new URL('/', siteUrl).toString(),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Insights',
        item: new URL('/insights', siteUrl).toString(),
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: category?.shortLabel || typedArticle.category,
        item: new URL(`/insights?categorie=${typedArticle.category}`, siteUrl).toString(),
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: typedArticle.title,
        item: pageUrl,
      },
    ],
  },
  {
    '@type': 'Person',
    '@id': `${authorUrl}#person`,
    name: author.name,
    jobTitle: author.role,
    image: new URL(author.image, siteUrl).toString(),
    url: authorUrl,
    worksFor: {
      '@id': organizationId,
    },
  },
];

if (isIndexable) {
  schemaGraph.push(
    {
      '@type': 'BlogPosting',
      '@id': `${pageUrl}#article`,
      headline: typedArticle.title,
      description: typedArticle.metaDescription,
      image: new URL(typedArticle.ogImage, siteUrl).toString(),
      author: {
        '@id': `${authorUrl}#person`,
      },
      publisher: {
        '@id': organizationId,
      },
      datePublished: typedArticle.publishedAt,
      dateModified: typedArticle.updatedAt || typedArticle.publishedAt,
      mainEntityOfPage: pageUrl,
      articleSection: category?.label || typedArticle.category,
      keywords,
      inLanguage: 'fr-MA',
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: typedArticle.faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  );
}

const schema = {
  '@context': 'https://schema.org',
  '@graph': schemaGraph,
};
---
<BaseLayout
  title={typedArticle.seoTitle}
  description={typedArticle.metaDescription}
  canonical={typedArticle.canonical}
  ogImage={typedArticle.ogImage}
  ogType="article"
  robots={isIndexable ? 'index,follow' : 'noindex,nofollow'}
  schema={schema}
  bodyClass="insights-page insight-detail-page"
>
  <Header ctaLabel="Réservez un appel" ctaHref={contact.bookingHref} />
  <main>
    <InsightDetailHero article={typedArticle} author={author} />
    <InsightTakeaways article={typedArticle} />

    <div class="id-mobile-toc lm-shell">
      <InsightToc article={typedArticle} variant="mobile" />
    </div>

    <div class="id-article-wrap">
      <div class="lm-shell id-article-layout">
        <InsightArticleBody article={typedArticle} />
        <InsightSidebar article={typedArticle} relatedArticles={relatedArticles} />
      </div>
    </div>

    <section class="id-bottom lm-shell" aria-label="Auteur et newsletter">
      <InsightAuthorBox author={author} />
    </section>

    <InsightsNewsletter
      className="in-newsletter--detail"
      eyebrow="Newsletter"
      title="Recevez nos prochains insights directement dans votre boîte mail."
      text="Analyses, tendances et ressources utiles, directement dans votre boîte mail."
    />
  </main>
  <InsightsInteractions />
  <InsightDetailInteractions />
  <Footer />
</BaseLayout>
