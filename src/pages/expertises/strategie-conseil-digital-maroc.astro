---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ConsultingServices from '../../components/strategy-consulting/ConsultingServices.astro';
import DigitalAudit from '../../components/strategy-consulting/DigitalAudit.astro';
import DigitalStrategyDefinition from '../../components/strategy-consulting/DigitalStrategyDefinition.astro';
import StrategyCaseStudies from '../../components/strategy-consulting/StrategyCaseStudies.astro';
import StrategyChallenges from '../../components/strategy-consulting/StrategyChallenges.astro';
import StrategyFaq from '../../components/strategy-consulting/StrategyFaq.astro';
import StrategyFinalCta from '../../components/strategy-consulting/StrategyFinalCta.astro';
import StrategyFramework from '../../components/strategy-consulting/StrategyFramework.astro';
import StrategyHero from '../../components/strategy-consulting/StrategyHero.astro';
import StrategyInteractions from '../../components/strategy-consulting/StrategyInteractions.astro';
import StrategyMethod from '../../components/strategy-consulting/StrategyMethod.astro';
import { contact } from '../../data/homepage';
import {
  strategyContactHref,
  strategyConsultingMeta,
  strategyFaq,
  strategyRelatedLinks,
} from '../../data/strategyConsulting';
import '../../styles/strategy-consulting.css';

const siteUrl = import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://lemonmind.agency';
const pageUrl = new URL(strategyConsultingMeta.canonical, siteUrl).toString();
const organizationId = `${siteUrl}#organization`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Lemon Mind',
      url: siteUrl,
      telephone: contact.phone,
      email: contact.email,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Casablanca',
        addressCountry: 'MA',
      },
      areaServed: {
        '@type': 'Country',
        name: 'Maroc',
      },
    },
    {
      '@type': 'Service',
      '@id': `${pageUrl}#service`,
      name: 'Stratégie digitale et conseil marketing',
      serviceType: 'Stratégie digitale et conseil marketing',
      provider: {
        '@id': organizationId,
      },
      areaServed: {
        '@type': 'Country',
        name: 'Maroc',
      },
      url: pageUrl,
      relatedLink: strategyRelatedLinks.map((link) => new URL(link.href, siteUrl).toString()),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Accueil',
          item: new URL('/', siteUrl).toString(),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Nos expertises',
          item: new URL('/nos-expertises', siteUrl).toString(),
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Stratégie & Conseil Digital',
          item: pageUrl,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: strategyFaq.questions.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ],
};
---
<BaseLayout
  title={strategyConsultingMeta.title}
  description={strategyConsultingMeta.description}
  canonical={strategyConsultingMeta.canonical}
  ogImage={strategyConsultingMeta.ogImage}
  schema={schema}
  bodyClass="strategy-page"
>
  <Header ctaLabel="Parler de votre projet" ctaHref={strategyContactHref} />
  <main>
    <StrategyHero />
    <DigitalStrategyDefinition />
    <StrategyChallenges />
    <DigitalAudit />
    <StrategyFramework />
    <ConsultingServices />
    <StrategyMethod />
    <StrategyCaseStudies />
    <StrategyFaq />
    <StrategyFinalCta />
  </main>
  <StrategyInteractions />
  <Footer />
</BaseLayout>
