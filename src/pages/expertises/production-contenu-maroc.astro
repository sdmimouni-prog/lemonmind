---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductionCapabilities from '../../components/production/ProductionCapabilities.astro';
import ProductionFaq from '../../components/production/ProductionFaq.astro';
import ProductionFinalCta from '../../components/production/ProductionFinalCta.astro';
import ProductionHero from '../../components/production/ProductionHero.astro';
import ProductionInteractions from '../../components/production/ProductionInteractions.astro';
import ProductionMethod from '../../components/production/ProductionMethod.astro';
import ProductionPlatforms from '../../components/production/ProductionPlatforms.astro';
import ProductionProjects from '../../components/production/ProductionProjects.astro';
import ProductionShowreel from '../../components/production/ProductionShowreel.astro';
import ProductionUgcCreators from '../../components/production/ProductionUgcCreators.astro';
import ProductionVision from '../../components/production/ProductionVision.astro';
import { productionContentMeta, productionFaq } from '../../data/productionContent';
import '../../styles/production-content.css';

const siteUrl = import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://lemonmind.agency';
const pageUrl = new URL(productionContentMeta.canonical, siteUrl).toString();

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${pageUrl}#service`,
      name: 'Production vidéo et UGC au Maroc',
      serviceType: 'Production de contenu, vidéo, Reels, UGC et shooting',
      provider: {
        '@type': 'Organization',
        name: 'Lemon Mind',
        url: siteUrl,
      },
      areaServed: {
        '@type': 'Country',
        name: 'Maroc',
      },
      url: pageUrl,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Accueil',
          item: new URL('/', siteUrl).toString(),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Nos expertises',
          item: new URL('/nos-expertises', siteUrl).toString(),
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Production de contenu',
          item: pageUrl,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: productionFaq.questions.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ],
};
---
<BaseLayout
  title={productionContentMeta.title}
  description={productionContentMeta.description}
  canonical={productionContentMeta.canonical}
  ogImage={productionContentMeta.ogImage}
  schema={schema}
  bodyClass="production-content-page"
>
  <Header />
  <main>
    <ProductionHero />
    <ProductionVision />
    <ProductionCapabilities />
    <ProductionMethod />
    <ProductionUgcCreators />
    <ProductionPlatforms />
    <ProductionShowreel />
    <ProductionProjects />
    <ProductionFaq />
    <ProductionFinalCta />
  </main>
  <ProductionInteractions />
  <Footer />
</BaseLayout>
