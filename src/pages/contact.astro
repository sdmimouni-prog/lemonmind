---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactAfterSubmit from '../components/contact/ContactAfterSubmit.astro';
import ContactDirect from '../components/contact/ContactDirect.astro';
import ContactFaq from '../components/contact/ContactFaq.astro';
import ContactFinalCta from '../components/contact/ContactFinalCta.astro';
import ContactHero from '../components/contact/ContactHero.astro';
import ContactInteractions from '../components/contact/ContactInteractions.astro';
import ContactNeedPicker from '../components/contact/ContactNeedPicker.astro';
import { contactDetails, contactFaq, contactMeta } from '../data/contactContent';
import '../styles/contact.css';

const siteUrl = import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://lemonmind.agency';
const pageUrl = new URL(contactMeta.canonical, siteUrl).toString();

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      '@id': `${pageUrl}#page`,
      name: contactMeta.title,
      description: contactMeta.description,
      url: pageUrl,
      inLanguage: 'fr-MA',
      about: {
        '@id': `${siteUrl}#organization`,
      },
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: 'Lemon Mind Digital',
      url: siteUrl,
      email: contactDetails.email,
      telephone: contactDetails.phone.replace(/\s/g, ''),
      areaServed: {
        '@type': 'Country',
        name: 'Maroc',
      },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer service',
        telephone: contactDetails.phone.replace(/\s/g, ''),
        email: contactDetails.email,
        areaServed: 'MA',
        availableLanguage: ['fr', 'ar'],
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Accueil',
          item: new URL('/', siteUrl).toString(),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Contact',
          item: pageUrl,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: contactFaq.questions.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ],
};
---
<BaseLayout
  title={contactMeta.title}
  description={contactMeta.description}
  canonical={contactMeta.canonical}
  ogImage={contactMeta.ogImage}
  schema={schema}
  bodyClass="contact-page"
>
  <Header ctaLabel="Nous contacter" ctaHref="#contact-form" />
  <main>
    <ContactHero />
    <ContactNeedPicker />
    <ContactAfterSubmit />
    <ContactDirect />
    <ContactFaq />
    <ContactFinalCta />
  </main>
  <ContactInteractions />
  <Footer />
</BaseLayout>
