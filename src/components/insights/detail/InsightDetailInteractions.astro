<script is:inline>
  (() => {
    document.documentElement.classList.add('detail-motion-ready');

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const progressBar = document.querySelector('[data-reading-progress]');
    const articleMain = document.querySelector('[data-insight-main]');
    const revealNodes = Array.from(document.querySelectorAll('[data-detail-reveal]'));
    const tocLinks = Array.from(document.querySelectorAll('[data-detail-toc-link]'));
    const tocButton = document.querySelector('[data-detail-toc-button]');
    const tocPanel = document.querySelector('[data-detail-toc-panel]');
    let ticking = false;

    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const updateProgress = () => {
      if (!progressBar || !articleMain) {
        return;
      }

      const rect = articleMain.getBoundingClientRect();
      const scrollTop = window.scrollY || window.pageYOffset;
      const start = rect.top + scrollTop - 96;
      const end = start + articleMain.scrollHeight - window.innerHeight * 0.72;
      const value = end <= start ? 1 : clamp((scrollTop - start) / (end - start), 0, 1);

      progressBar.style.transform = `scaleX(${value})`;
    };

    const onScroll = () => {
      if (ticking) {
        return;
      }

      ticking = true;
      window.requestAnimationFrame(() => {
        updateProgress();
        ticking = false;
      });
    };

    updateProgress();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);

    if (!('IntersectionObserver' in window) || prefersReducedMotion.matches) {
      revealNodes.forEach((node) => node.classList.add('is-detail-visible'));
    } else {
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-detail-visible');
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '8% 0px 6% 0px' },
      );

      revealNodes.forEach((node) => revealObserver.observe(node));
    }

    window.setTimeout(() => {
      revealNodes.forEach((node) => node.classList.add('is-detail-visible'));
    }, 1400);

    const sectionIds = [...new Set(tocLinks.map((link) => link.getAttribute('data-detail-toc-target')).filter(Boolean))];
    const sections = sectionIds
      .map((id) => document.getElementById(id))
      .filter(Boolean);

    const setActiveToc = (id) => {
      tocLinks.forEach((link) => {
        const isActive = link.getAttribute('data-detail-toc-target') === id;
        link.toggleAttribute('aria-current', isActive);
      });
    };

    if ('IntersectionObserver' in window && sections.length) {
      const spyObserver = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((left, right) => Math.abs(left.boundingClientRect.top) - Math.abs(right.boundingClientRect.top))[0];

          if (visible?.target?.id) {
            setActiveToc(visible.target.id);
          }
        },
        { rootMargin: '-24% 0px -60% 0px', threshold: [0.01, 0.2, 0.48] },
      );

      sections.forEach((section) => spyObserver.observe(section));
    }

    tocLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        const targetId = link.getAttribute('data-detail-toc-target');
        const target = targetId ? document.getElementById(targetId) : null;

        if (!target) {
          return;
        }

        event.preventDefault();
        target.scrollIntoView({
          behavior: prefersReducedMotion.matches ? 'auto' : 'smooth',
          block: 'start',
        });
        setActiveToc(targetId);

        if (tocButton && tocPanel) {
          tocButton.setAttribute('aria-expanded', 'false');
          tocPanel.setAttribute('hidden', '');
        }
      });
    });

    if (tocButton && tocPanel) {
      tocButton.addEventListener('click', () => {
        const isOpen = tocButton.getAttribute('aria-expanded') === 'true';
        tocButton.setAttribute('aria-expanded', String(!isOpen));
        tocPanel.toggleAttribute('hidden', isOpen);
      });
    }

    const faqButtons = Array.from(document.querySelectorAll('[data-detail-faq-button]'));
    const closeFaq = (button) => {
      const panelId = button.getAttribute('aria-controls');
      const panel = panelId ? document.getElementById(panelId) : null;
      button.setAttribute('aria-expanded', 'false');
      panel?.setAttribute('hidden', '');
    };
    const openFaq = (button) => {
      const panelId = button.getAttribute('aria-controls');
      const panel = panelId ? document.getElementById(panelId) : null;
      button.setAttribute('aria-expanded', 'true');
      panel?.removeAttribute('hidden');
    };

    faqButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const willOpen = button.getAttribute('aria-expanded') !== 'true';

        faqButtons.forEach(closeFaq);

        if (willOpen) {
          openFaq(button);
        }
      });

      button.addEventListener('keydown', (event) => {
        const currentIndex = faqButtons.indexOf(button);
        const lastIndex = faqButtons.length - 1;
        let nextIndex = currentIndex;

        if (event.key === 'ArrowDown') {
          nextIndex = currentIndex === lastIndex ? 0 : currentIndex + 1;
        } else if (event.key === 'ArrowUp') {
          nextIndex = currentIndex === 0 ? lastIndex : currentIndex - 1;
        } else if (event.key === 'Home') {
          nextIndex = 0;
        } else if (event.key === 'End') {
          nextIndex = lastIndex;
        } else {
          return;
        }

        event.preventDefault();
        faqButtons[nextIndex]?.focus();
      });
    });
  })();
</script>
