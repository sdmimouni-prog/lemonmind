---
import { contact } from '../../data/homepage';
import { expertisesCta } from '../../data/expertises';
---
<section class="xp-final-cta" aria-labelledby="expertises-final-title" data-xp-final-cta>
  <div class="lm-shell">
    <div class="xp-final-cta__panel">
      <div class="xp-final-cta__copy">
        <p class="lm-eyebrow lm-eyebrow--yellow">{expertisesCta.eyebrow}</p>
        <h2 id="expertises-final-title">{expertisesCta.title}</h2>
      </div>
      <div class="xp-final-cta__actions">
        <p>{expertisesCta.text}</p>
        <div>
          <a class="lm-button lm-button--yellow" href={contact.phoneHref}>
            {expertisesCta.primaryCta}
            <span aria-hidden="true">→</span>
          </a>
          <a class="lm-button lm-button--dark" href="/#realisations">
            {expertisesCta.secondaryCta}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <p class="xp-hand xp-hand--final">Plus loin<br />ensemble.</p>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const section = document.querySelector('[data-xp-final-cta]');
    const panel = section?.querySelector('.xp-final-cta__panel');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (!section || !panel) {
      return;
    }

    section.classList.add('is-motion-ready');

    if ('IntersectionObserver' in window && !prefersReducedMotion.matches) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              section.classList.add('is-visible');
              observer.disconnect();
            }
          });
        },
        { threshold: 0.08 },
      );

      observer.observe(section);
    } else {
      section.classList.add('is-visible');
    }

    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches || prefersReducedMotion.matches) {
      return;
    }

    panel.addEventListener('pointermove', (event) => {
      const rect = panel.getBoundingClientRect();
      panel.style.setProperty('--xp-cta-x', `${(((event.clientX - rect.left) / rect.width) * 100).toFixed(2)}%`);
      panel.style.setProperty('--xp-cta-y', `${(((event.clientY - rect.top) / rect.height) * 100).toFixed(2)}%`);
    });

    panel.addEventListener('pointerleave', () => {
      panel.style.setProperty('--xp-cta-x', '68%');
      panel.style.setProperty('--xp-cta-y', '48%');
    });
  })();
</script>
