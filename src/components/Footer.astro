---
import { contact, footerColumns } from '../data/homepage';
---
<footer class="site-footer site-footer--standard" id="contact" data-footer-scene>
  <div class="lm-pixel-cloud lm-pixel-cloud--footer" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span>
  </div>
  <div class="lm-shell site-footer__grid">
    <div class="site-footer__brand">
      <img src="/assets/lemon-mind-logo.png" alt="Lemon Mind Digital" width="560" height="320" />
      <p class="site-footer__question">Et si votre prochain projet devenait notre prochaine réussite ?</p>
      <p>Chaque collaboration est une nouvelle opportunité de créer, d’innover et de générer un impact.</p>
      <div class="site-footer__contact">
        <a class="site-footer__contact-link site-footer__contact-link--phone" href={contact.phoneHref}>{contact.phone}</a>
        <a class="site-footer__contact-link site-footer__contact-link--mail" href={contact.emailHref}>{contact.email}</a>
      </div>
      <div class="site-footer__social" aria-label="Réseaux sociaux">
        <a class="site-footer__social-link site-footer__social-link--facebook" href={contact.contactHref} aria-label="Facebook">f</a>
        <a class="site-footer__social-link site-footer__social-link--instagram" href={contact.contactHref} aria-label="Instagram">ig</a>
        <a class="site-footer__social-link site-footer__social-link--linkedin" href={contact.contactHref} aria-label="LinkedIn">in</a>
      </div>
    </div>

    <nav class="site-footer__columns" aria-label="Navigation du footer">
      {footerColumns.map((column) => (
        <div>
          <h2>{column.title}</h2>
          {column.links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </div>
      ))}
    </nav>
  </div>

  <div class="lm-shell site-footer__bottom">
    <span>© 2026 Lemon Mind Digital</span>
    <a href="/mentions-legales">Mentions légales</a>
    <a href="/politique-confidentialite">Politique de confidentialité</a>
    <a href="/politique-cookies">Politique cookies</a>
  </div>
</footer>

<style is:inline>
  .site-footer.site-footer--standard {
    position: relative;
    z-index: 1;
    min-height: auto;
    margin-top: 0;
    overflow: hidden;
    padding: 40px 0 18px;
    background:
      radial-gradient(ellipse at 22% 0%, rgba(154, 132, 239, 0.18), transparent 34%),
      radial-gradient(ellipse at 92% 28%, rgba(253, 199, 0, 0.14), transparent 32%),
      linear-gradient(110deg, #060707 0%, #0a0c0c 58%, #050506 100%);
    color: var(--lm-white);
  }

  .site-footer.site-footer--standard::before,
  .site-footer.site-footer--standard::after {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    content: "";
  }

  .site-footer.site-footer--standard::before {
    background:
      radial-gradient(ellipse at 38% 0%, rgba(255, 255, 255, 0.06), transparent 36%),
      radial-gradient(ellipse at 82% 100%, rgba(253, 199, 0, 0.08), transparent 34%);
    opacity: 0.82;
  }

  .site-footer.site-footer--standard::after {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.026) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.022) 1px, transparent 1px);
    background-size: 42px 42px;
    opacity: 0.34;
  }

  .site-footer.site-footer--standard .site-footer__grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(240px, 330px) minmax(0, 1fr);
    gap: clamp(42px, 6vw, 88px);
    align-items: start;
    padding-block: 0 24px;
  }

  .site-footer.site-footer--standard .site-footer__brand {
    display: grid;
    gap: 10px;
  }

  .site-footer.site-footer--standard .site-footer__brand img {
    width: 132px;
    height: auto;
    max-width: 100%;
    filter: drop-shadow(0 16px 24px rgba(0, 0, 0, 0.32));
  }

  .site-footer.site-footer--standard .site-footer__brand p {
    max-width: 330px;
    color: rgba(255, 255, 255, 0.66);
    font-size: 11px;
    font-weight: 700;
    line-height: 1.42;
  }

  .site-footer.site-footer--standard .site-footer__question {
    margin-top: 0;
    color: rgba(255, 255, 255, 0.9);
    font-size: 12px;
    font-weight: 900;
  }

  .site-footer.site-footer--standard .site-footer__contact {
    display: grid;
    gap: 8px;
    margin-top: 8px;
  }

  .site-footer.site-footer--standard .site-footer__contact a {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 10px;
    color: rgba(255, 255, 255, 0.86);
    font-size: 12px;
    font-weight: 900;
    line-height: 1;
    text-decoration: none;
  }

  .site-footer.site-footer--standard .site-footer__contact a::before {
    display: grid;
    width: 20px;
    height: 20px;
    place-items: center;
    border-radius: 50%;
    background: var(--lm-yellow);
    color: #070707;
    font-size: 11px;
    font-weight: 900;
    box-shadow: 0 0 0 4px rgba(253, 199, 0, 0.12);
  }

  .site-footer.site-footer--standard .site-footer__contact-link--phone::before {
    content: "☎";
  }

  .site-footer.site-footer--standard .site-footer__contact-link--mail::before {
    content: "@";
  }

  .site-footer.site-footer--standard .site-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 8px;
  }

  .site-footer.site-footer--standard .site-footer__social a {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 50%;
    color: #fff;
    font-size: 11px;
    font-weight: 950;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 12px 22px rgba(0, 0, 0, 0.32);
  }

  .site-footer.site-footer--standard .site-footer__columns {
    display: grid;
    grid-template-columns: repeat(4, minmax(120px, 1fr));
    gap: clamp(24px, 4vw, 58px);
    padding-top: 18px;
  }

  .site-footer.site-footer--standard .site-footer__columns div {
    display: grid;
    gap: 10px;
  }

  .site-footer.site-footer--standard .site-footer__columns h2 {
    margin: 0 0 4px;
    color: var(--lm-white);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 950;
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
  }

  .site-footer.site-footer--standard .site-footer__columns a {
    width: fit-content;
    color: rgba(255, 255, 255, 0.62);
    font-size: 11px;
    font-weight: 750;
    line-height: 1.25;
    text-decoration: none;
  }

  .site-footer.site-footer--standard .site-footer__bottom {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 18px 34px;
    align-items: center;
    justify-content: flex-start;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 18px;
    padding-bottom: 0;
    color: rgba(255, 255, 255, 0.56);
    font-size: 10px;
    font-weight: 750;
  }

  .site-footer.site-footer--standard .site-footer__bottom span {
    margin-right: auto;
  }

  .site-footer.site-footer--standard .site-footer__bottom a {
    color: inherit;
    font-size: inherit;
    font-weight: 800;
    text-decoration: none;
  }

  .site-footer.site-footer--standard.is-motion-ready .site-footer__brand,
  .site-footer.site-footer--standard.is-motion-ready .site-footer__columns > div,
  .site-footer.site-footer--standard.is-motion-ready .site-footer__bottom,
  .site-footer.site-footer--standard.is-motion-ready .lm-pixel-cloud--footer span,
  .site-footer.site-footer--standard.is-motion-ready.is-visible .site-footer__brand,
  .site-footer.site-footer--standard.is-motion-ready.is-visible .site-footer__columns > div,
  .site-footer.site-footer--standard.is-motion-ready.is-visible .site-footer__bottom,
  .site-footer.site-footer--standard.is-motion-ready.is-visible .lm-pixel-cloud--footer span {
    opacity: 1;
    filter: none;
    translate: 0 0;
    animation: none;
  }

  .site-footer.site-footer--standard .site-footer__contact a:hover,
  .site-footer.site-footer--standard .site-footer__contact a:focus-visible,
  .site-footer.site-footer--standard .site-footer__social a:hover,
  .site-footer.site-footer--standard .site-footer__social a:focus-visible,
  .site-footer.site-footer--standard .site-footer__columns a:hover,
  .site-footer.site-footer--standard .site-footer__columns a:focus-visible,
  .site-footer.site-footer--standard .site-footer__bottom a:hover,
  .site-footer.site-footer--standard .site-footer__bottom a:focus-visible {
    color: var(--lm-yellow);
    outline: none;
  }

  .site-footer.site-footer--standard .lm-pixel-cloud--footer {
    position: absolute;
    right: 30px;
    bottom: 26px;
    z-index: 1;
    width: 112px;
    height: 96px;
    opacity: 0.42;
    pointer-events: none;
  }

  .site-footer.site-footer--standard .lm-pixel-cloud--footer span {
    position: absolute;
    display: block;
    border-radius: 1px;
    background: rgba(253, 199, 0, 0.42);
  }

  .site-footer.site-footer--standard .lm-pixel-cloud--footer span:nth-child(1) {
    top: 10px;
    right: 34px;
    width: 10px;
    height: 10px;
  }

  .site-footer.site-footer--standard .lm-pixel-cloud--footer span:nth-child(2) {
    top: 25px;
    right: 48px;
    width: 16px;
    height: 16px;
  }

  .site-footer.site-footer--standard .lm-pixel-cloud--footer span:nth-child(3) {
    top: 44px;
    right: 15px;
    width: 34px;
    height: 34px;
  }

  .site-footer.site-footer--standard .lm-pixel-cloud--footer span:nth-child(4) {
    top: 62px;
    right: 64px;
    width: 24px;
    height: 24px;
  }

  .site-footer.site-footer--standard .lm-pixel-cloud--footer span:nth-child(5) {
    top: 74px;
    right: 0;
    width: 30px;
    height: 30px;
  }

  @media (max-width: 1024px) {
    .site-footer.site-footer--standard {
      padding-top: 38px;
    }

    .site-footer.site-footer--standard .site-footer__grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .site-footer.site-footer--standard .site-footer__columns {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 22px;
      padding-top: 0;
    }
  }

  @media (max-width: 768px) {
    .site-footer.site-footer--standard {
      padding-top: 34px;
    }

    .site-footer.site-footer--standard .site-footer__grid {
      gap: 26px;
    }

    .site-footer.site-footer--standard .site-footer__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-footer.site-footer--standard .site-footer__bottom {
      display: grid;
      gap: 10px;
    }

    .site-footer.site-footer--standard .site-footer__bottom span {
      margin-right: 0;
    }

    .site-footer.site-footer--standard .lm-pixel-cloud--footer {
      display: none;
    }
  }

  @media (max-width: 430px) {
    .site-footer.site-footer--standard .site-footer__brand img {
      width: 118px;
    }

    .site-footer.site-footer--standard .site-footer__columns {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  (() => {
    const footer = document.querySelector('[data-footer-scene]');

    if (!footer) {
      return;
    }

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    footer.classList.add('is-motion-ready');

    if ('IntersectionObserver' in window && !prefersReducedMotion.matches) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              footer.classList.add('is-visible');
              observer.disconnect();
            }
          });
        },
        { threshold: 0.2 },
      );

      observer.observe(footer);
    } else {
      footer.classList.add('is-visible');
    }

    window.setTimeout(() => {
      footer.classList.add('is-visible');
    }, 1200);
  })();
</script>
