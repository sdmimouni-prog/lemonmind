---
import { agencyFinalCta, agencyLinks } from '../../data/agency';
---
<section class="ag-final" aria-labelledby="agency-final-title" data-ag-scene>
  <div class="ag-final__orb ag-final__orb--one" aria-hidden="true"></div>
  <div class="ag-final__orb ag-final__orb--two" aria-hidden="true"></div>
  <div class="lm-shell ag-final__grid">
    <div>
      {agencyFinalCta.eyebrow && <p class="lm-eyebrow" data-ag-line>{agencyFinalCta.eyebrow}</p>}
      <h2 id="agency-final-title" data-ag-title>{agencyFinalCta.title}</h2>
    </div>
    <div class="ag-final__content" data-ag-reveal>
      <p>{agencyFinalCta.text}</p>
      <div class="ag-actions">
        <a class="lm-button lm-button--dark ag-final__primary" href={agencyLinks.contact}>
          {agencyFinalCta.primaryCta}
          <span aria-hidden="true">→</span>
        </a>
        <a class="lm-button ag-final__secondary" href={agencyLinks.realisations}>
          {agencyFinalCta.secondaryCta}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <p class="ag-hand ag-hand--final">{agencyFinalCta.annotation}</p>
  </div>
</section>
