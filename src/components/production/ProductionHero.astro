---
import { contact } from '../../data/homepage';
import { productionHero } from '../../data/productionContent';
---
<section class="pc-hero" aria-labelledby="pc-hero-title" data-pc-scene data-pc-parallax>
  <div class="pc-pixels pc-pixels--hero" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>
  <div class="lm-shell pc-hero__grid">
    <div class="pc-hero__copy">
      <p class="lm-eyebrow lm-eyebrow--yellow" data-pc-reveal>{productionHero.eyebrow}</p>
      <h1 id="pc-hero-title" aria-label={productionHero.title} data-pc-reveal>
        Agence de production<br />
        de contenu, vidéo et UGC<br />
        <span>{productionHero.highlight}</span>
      </h1>
      <p class="pc-hero__lead" data-pc-reveal>
        {productionHero.lead.map((line) => <span>{line}</span>)}
      </p>
      <p class="pc-hero__text" data-pc-reveal>{productionHero.text}</p>
      <div class="pc-actions" data-pc-reveal>
        <a class="lm-button lm-button--yellow" href={contact.phoneHref}>
          {productionHero.primaryCta}
          <span aria-hidden="true">→</span>
        </a>
        <a class="lm-button lm-button--dark" href="#production-coulisses">
          {productionHero.secondaryCta}
          <span aria-hidden="true">▷</span>
        </a>
      </div>
    </div>

    <div class="pc-hero__stage" aria-label="Studio de production Lemon Mind">
      <figure class="pc-hero__main" data-pc-layer="main">
        <img
          src={productionHero.mainImage}
          alt="Studio de production Lemon Mind avec caméra, lumière et préparation de contenus"
          width="1280"
          height="720"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
      <figure class="pc-phone pc-hero__phone" data-pc-layer="phone">
        <span class="pc-phone__speaker" aria-hidden="true"></span>
        <img
          src={productionHero.phoneImage}
          alt="Aperçu vertical d'un contenu final social-first"
          width="560"
          height="996"
          loading="eager"
          decoding="async"
        />
        <figcaption>
          <strong>Contenu final</strong>
          <span>Prêt à diffuser</span>
        </figcaption>
      </figure>
      <p class="pc-hand pc-hand--hero" data-pc-layer="hand">{productionHero.annotation}</p>
      <div class="pc-hero__tags" aria-label="Formats mis en avant">
        {productionHero.tags.map((tag, index) => (
          <span class={`pc-floating-tag pc-floating-tag--${index + 1}`} style={`--pc-order: ${index};`}>
            {tag}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
