<script is:inline>
  (() => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const scenes = Array.from(document.querySelectorAll('[data-team-scene]'));

    scenes.forEach((scene) => {
      scene.classList.add('is-motion-ready');

      if (!('IntersectionObserver' in window) || prefersReducedMotion.matches) {
        scene.classList.add('is-visible');
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              scene.classList.add('is-visible');
              observer.disconnect();
            }
          });
        },
        { threshold: 0.12, rootMargin: '12% 0px 8% 0px' },
      );

      observer.observe(scene);
    });

    window.setTimeout(() => {
      scenes.forEach((scene) => scene.classList.add('is-visible'));
    }, 1400);

    if (finePointer && !prefersReducedMotion.matches) {
      document.querySelectorAll('[data-team-parallax]').forEach((scene) => {
        scene.addEventListener('pointermove', (event) => {
          const rect = scene.getBoundingClientRect();
          const x = ((event.clientX - rect.left) / rect.width - 0.5) * 2;
          const y = ((event.clientY - rect.top) / rect.height - 0.5) * 2;

          scene.style.setProperty('--team-mx', x.toFixed(3));
          scene.style.setProperty('--team-my', y.toFixed(3));
        });

        scene.addEventListener('pointerleave', () => {
          scene.style.setProperty('--team-mx', '0');
          scene.style.setProperty('--team-my', '0');
        });
      });

      document.querySelectorAll('[data-team-depth]').forEach((item) => {
        item.addEventListener('pointermove', (event) => {
          const rect = item.getBoundingClientRect();
          const x = ((event.clientX - rect.left) / rect.width - 0.5) * 2;
          const y = ((event.clientY - rect.top) / rect.height - 0.5) * 2;

          item.style.setProperty('--team-tilt-x', `${(y * -3).toFixed(2)}deg`);
          item.style.setProperty('--team-tilt-y', `${(x * 4).toFixed(2)}deg`);
        });

        item.addEventListener('pointerleave', () => {
          item.style.setProperty('--team-tilt-x', '0deg');
          item.style.setProperty('--team-tilt-y', '0deg');
        });
      });
    }

    const filterButtons = Array.from(document.querySelectorAll('[data-team-filter]'));
    const cards = Array.from(document.querySelectorAll('[data-team-card]'));
    const directory = document.querySelector('#team-directory');

    const applyFilter = (filter, { scroll = false, focus = false } = {}) => {
      filterButtons.forEach((button) => {
        const isActive = button.getAttribute('data-team-filter') === filter;
        button.setAttribute('aria-pressed', String(isActive));
        if (isActive && focus) {
          button.focus({ preventScroll: true });
        }
      });

      cards.forEach((card, index) => {
        const shouldShow = filter === 'all' || card.getAttribute('data-department') === filter;
        card.toggleAttribute('hidden', !shouldShow);
        card.classList.remove('is-filtered-in');

        if (shouldShow) {
          card.style.setProperty('--team-item-index', String(index % 8));
          window.requestAnimationFrame(() => card.classList.add('is-filtered-in'));
        }
      });

      document.querySelectorAll('[data-team-dept-jump]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.getAttribute('data-team-dept-jump') === filter));
      });

      if (scroll) {
        directory?.scrollIntoView({ block: 'start', behavior: prefersReducedMotion.matches ? 'auto' : 'smooth' });
      }
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        applyFilter(button.getAttribute('data-team-filter') || 'all');
      });
    });

    document.querySelectorAll('[data-team-dept-jump]').forEach((button) => {
      button.setAttribute('aria-pressed', 'false');
      button.addEventListener('click', () => {
        applyFilter(button.getAttribute('data-team-dept-jump') || 'all', { scroll: true, focus: true });
      });
    });

    applyFilter('all');
  })();
</script>
