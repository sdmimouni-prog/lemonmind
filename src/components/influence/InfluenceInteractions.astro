<script is:inline>
  (() => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    const scenes = document.querySelectorAll('[data-im-scene]');

    scenes.forEach((scene) => {
      scene.classList.add('is-motion-ready');

      if (!('IntersectionObserver' in window) || prefersReducedMotion.matches) {
        scene.classList.add('is-visible');
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              scene.classList.add('is-visible');
              observer.disconnect();
            }
          });
        },
        { threshold: 0.18, rootMargin: '0px 0px -8% 0px' },
      );

      observer.observe(scene);
    });

    const hero = document.querySelector('[data-im-hero]');
    const stage = hero?.querySelector('[data-im-hero-stage]');
    let raf = 0;

    if (hero && stage && !prefersReducedMotion.matches && finePointer.matches) {
      stage.addEventListener('pointermove', (event) => {
        window.cancelAnimationFrame(raf);
        raf = window.requestAnimationFrame(() => {
          const rect = stage.getBoundingClientRect();
          const x = ((event.clientX - rect.left) / rect.width - 0.5) * 2;
          const y = ((event.clientY - rect.top) / rect.height - 0.5) * 2;

          stage.style.setProperty('--im-pointer-x', `${x.toFixed(3)}`);
          stage.style.setProperty('--im-pointer-y', `${y.toFixed(3)}`);
        });
      });

      stage.addEventListener('pointerleave', () => {
        window.cancelAnimationFrame(raf);
        stage.style.setProperty('--im-pointer-x', '0');
        stage.style.setProperty('--im-pointer-y', '0');
      });
    }

    if (!prefersReducedMotion.matches && finePointer.matches) {
      document.querySelectorAll('[data-im-depth]').forEach((item) => {
        item.addEventListener('pointermove', (event) => {
          const rect = item.getBoundingClientRect();
          const x = ((event.clientX - rect.left) / rect.width - 0.5) * 2;
          const y = ((event.clientY - rect.top) / rect.height - 0.5) * 2;

          item.style.setProperty('--im-depth-x', `${(x * 10).toFixed(2)}px`);
          item.style.setProperty('--im-depth-y', `${(y * 8).toFixed(2)}px`);
          item.style.setProperty('--im-depth-tilt', `${(x * -1.2).toFixed(2)}deg`);
        });

        item.addEventListener('pointerleave', () => {
          item.style.setProperty('--im-depth-x', '0px');
          item.style.setProperty('--im-depth-y', '0px');
          item.style.setProperty('--im-depth-tilt', '0deg');
        });
      });
    }

    document.querySelectorAll('[data-im-faq-list]').forEach((list) => {
      const buttons = Array.from(list.querySelectorAll('[data-im-faq-button]'));
      const panels = Array.from(list.querySelectorAll('[data-im-faq-panel]'));

      const setOpen = (button) => {
        buttons.forEach((currentButton) => {
          const isSelected = currentButton === button;
          const panelId = currentButton.getAttribute('aria-controls');
          const panel = panelId ? document.getElementById(panelId) : null;

          currentButton.setAttribute('aria-expanded', String(isSelected));
          panel?.setAttribute('data-open', String(isSelected));
        });
      };

      buttons.forEach((button) => {
        button.addEventListener('click', () => setOpen(button));
      });

      panels.forEach((panel) => {
        if (!panel.getAttribute('data-open')) {
          panel.setAttribute('data-open', 'false');
        }
      });
    });
  })();
</script>
