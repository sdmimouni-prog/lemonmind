---
import { mediaFaq } from '../../data/mediaAmplification';
---
<section class="sm-faq sm-section-light ma-faq" aria-labelledby="ma-faq-title" data-sm-scene>
  <div class="lm-shell sm-faq__grid">
    <div>
      <p class="lm-eyebrow" data-sm-reveal>{mediaFaq.eyebrow}</p>
      <h2 id="ma-faq-title" data-sm-reveal>{mediaFaq.title}</h2>
    </div>
    <div class="sm-faq__list" data-sm-faq-list data-sm-reveal>
      {mediaFaq.questions.map((item, index) => (
        <article class="sm-faq-item">
          <h3>
            <button
              type="button"
              id={`ma-faq-question-${index + 1}`}
              aria-expanded="false"
              aria-controls={`ma-faq-answer-${index + 1}`}
              data-sm-faq-button
            >
              <span>{item.question}</span>
              <span aria-hidden="true">+</span>
            </button>
          </h3>
          <div
            id={`ma-faq-answer-${index + 1}`}
            role="region"
            aria-labelledby={`ma-faq-question-${index + 1}`}
            data-sm-faq-panel
            data-open="false"
          >
            <p>{item.answer}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
