---
import { contact } from '../../../data/homepage';
---
<section class="rd-final-cta" aria-labelledby="realisation-final-title" data-rd-scene>
  <div class="lm-shell rd-final-cta__grid">
    <div class="rd-final-cta__copy" data-rd-reveal>
      <p class="rd-label">Prêt à écrire la prochaine histoire ?</p>
      <h2 id="realisation-final-title">Et si votre marque était notre prochain projet ?</h2>
    </div>
    <p data-rd-reveal style="--rd-order: 1;">
      Discutons de vos objectifs et imaginons ensemble une campagne qui fait la différence.
    </p>
    <div class="rd-final-cta__actions" data-rd-reveal style="--rd-order: 2;">
      <a class="lm-button lm-button--dark" href={contact.contactHref}>
        Parler de votre projet
        <span aria-hidden="true">→</span>
      </a>
      <a class="lm-button lm-button--yellow" href="/realisations">
        Voir nos réalisations
        <span aria-hidden="true">→</span>
      </a>
    </div>
    <p class="rd-hand rd-hand--final" aria-hidden="true">Same team. Bigger brands.</p>
  </div>
</section>
